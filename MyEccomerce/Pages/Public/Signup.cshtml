@model MyEccomerce.Models.User
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Signup - MyEcommerce</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

    <style>
            /* HD Background with Gradient Overlay */
            body {
                background: linear-gradient(rgba(15, 23, 42, 0.55), rgba(15, 23, 42, 0.75)), url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
                background-size: cover;
                min-height: 100vh;
                display: flex;
                align-items: center;
            }

            /* Modern Glassmorphism Card Style */
            .glass-card {
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: blur(12px);
                border-radius: 16px;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
                border: 1px solid rgba(255, 255, 255, 0.4);
            }

            .form-control, .form-select {
                border-radius: 8px;
                padding: 0.65rem 0.85rem;
                border: 1px solid #cbd5e1;
            }

                .form-control:focus, .form-select:focus {
                    border-color: #0d6efd;
                    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
                }

            .btn-primary {
                border-radius: 8px;
                transition: all 0.3s ease;
            }

                .btn-primary:hover {
                    transform: translateY(-1px);
                    box-shadow: 0 6px 20px rgba(13, 110, 253, 0.35);
                }
    </style>
</head>
<body>
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card glass-card border-0">
                    <div class="card-body p-4 p-sm-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark mb-1">Create Account</h2>
                            <p class="text-muted small">Welcome to Bantayan Island Marketplace</p>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger py-2 small rounded-3">@ViewBag.Error</div>
                        }

                        <form asp-action="Signup" method="post">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label small fw-semibold text-secondary">First Name</label>
                                    <input type="text" name="FirstName" class="form-control" required placeholder="First Name">
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label small fw-semibold text-secondary">Last Name</label>
                                    <input type="text" name="LastName" class="form-control" required placeholder="Last Name">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Email Address</label>
                                <input type="email" name="Email" class="form-control" required placeholder="name@example.com">
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Password</label>
                                <input type="password" name="Password" class="form-control" required placeholder="••••••••">
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Phone Number</label>
                                <input type="text" name="Phone" class="form-control" required placeholder="09123456789">
                            </div>

                            @* --- AREA SA ADDRESS --- *@
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label small fw-semibold text-secondary">Lungsod (Town)</label>
                                    <select class="form-select" id="townSelect" name="townInput" onchange="updateBarangay()" required>
                                        <option value="" selected disabled>Pili og Lungsod...</option>
                                        <option value="bantayan">Bantayan</option>
                                        <option value="madredejos">Madredejos</option>
                                        <option value="santafe">Santa Fe</option>
                                    </select>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label small fw-semibold text-secondary">Barangay</label>
                                    <select class="form-select" id="barangaySelect" name="barangayInput" onchange="updateSitio()" disabled required>
                                        <option value="">Pili una og Lungsod...</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-secondary">Sitio / Street</label>
                                <select class="form-select" id="sitioSelect" name="sitioInput" disabled required>
                                    <option value="">Pili una og Barangay...</option>
                                </select>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold py-2.5">REGISTER</button>
                        </form>

                        <div class="text-center mt-4 pt-2 border-top">
                            <p class="small text-muted mb-0">Naa na kay account? <a asp-action="Signin" class="text-primary fw-bold text-decoration-none">Login diri</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
            // Dynamic Address Dropdowns Data
            const addressData = {
                bantayan: {
                    "Ticad": ["Manan-ao", "Poblacion Side", "Suba"],
                    "Circulo": ["Sentro", "Gawas"],
                    "Terplen": ["Proper", "Baybay"]
                },
                madredejos: {
                    "Poblacion": ["Kanto", "Pantalan"],
                    "Bunakan": ["Sulangon", "Tugas"],
                    "Tarong": ["Proper", "Ubos"]
                },
                santafe: {
                    "Talisay": ["Alice Beach Side", "Sentro"],
                    "Pooc": ["Maricaban", "Gawas"],
                    "Okoy": ["Proper", "Crossing"]
                }
            };

            function updateBarangay() {
                const town = document.getElementById("townSelect").value;
                const brgySelect = document.getElementById("barangaySelect");
                const sitioSelect = document.getElementById("sitioSelect");

                brgySelect.innerHTML = '<option value="" selected disabled>Pili og Barangay...</option>';
                sitioSelect.innerHTML = '<option value="">Pili una og Barangay...</option>';
                sitioSelect.disabled = true;

                if (town) {
                    brgySelect.disabled = false;
                    Object.keys(addressData[town]).forEach(brgy => {
                        let opt = document.createElement("option");
                        opt.value = brgy;
                        opt.innerHTML = brgy;
                        brgySelect.appendChild(opt);
                    });
                }
            }

            function updateSitio() {
                const town = document.getElementById("townSelect").value;
                const brgy = document.getElementById("barangaySelect").value;
                const sitioSelect = document.getElementById("sitioSelect");

                sitioSelect.innerHTML = '<option value="" selected disabled>Pili og Sitio...</option>';

                if (brgy) {
                    sitioSelect.disabled = false;
                    addressData[town][brgy].forEach(sitio => {
                        let opt = document.createElement("option");
                        opt.value = sitio;
                        opt.innerHTML = sitio;
                        sitioSelect.appendChild(opt);
                    });
                }
            }
    </script>
</body>
</html>