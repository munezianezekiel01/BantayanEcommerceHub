@model List<MyEccomerce.Models.Order>
@inject MyEccomerce.Data.ApplicationDbContext _context
@{
    var user = ViewBag.CurrentUser as MyEccomerce.Models.User;
    var currentUser = _context.Users.FirstOrDefault(u => u.UserId == 1);
    Layout = "_AdminLayout";
}

<div class="container mt-5 mb-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold"><i class="bi bi-shop shadow-sm p-2 rounded bg-primary text-white"></i> Shop Owner Dashboard</h4>
        <span class="badge bg-danger rounded-pill px-3 py-2" id="pendingCounter">
            @Model.Count(x => x.Status == "Pending") Bag-ong Order
        </span>
    </div>

    <!-- Search ug Filter Tabs -->
    <div class="card shadow-sm border-0 mb-4 p-3 bg-white">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" id="orderSearch" class="form-control border-start-0 bg-light" placeholder="Pangitaa ang Customer o Order ID...">
                </div>
            </div>
            <div class="col-md-8 text-md-end">
                <button class="btn btn-sm btn-outline-secondary active filter-btn" onclick="filterOrders('All')">Tanan</button>
                <button class="btn btn-sm btn-outline-warning text-dark filter-btn" onclick="filterOrders('Pending')">Pending</button>
                <button class="btn btn-sm btn-outline-primary filter-btn" onclick="filterOrders('Confirmed')">Confirmed</button>
                <button class="btn btn-sm btn-outline-info filter-btn" onclick="filterOrders('Out for Delivery')">On the Way</button>
                <button class="btn btn-sm btn-outline-success filter-btn" onclick="filterOrders('Completed')">Completed</button>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center p-5 border rounded bg-light">
            <h5 class="text-muted">Walay order pa karon, @currentUser?.FirstName</h5>
        </div>
    }

    <!-- Orders Loop -->
    <div id="ordersContainer">
        @foreach (var order in Model)
        {
            var badgeClass = order.Status == "Pending" ? "bg-warning text-dark" :
            order.Status == "Assigned" ? "bg-info":
            order.Status == "Completed" ? "bg-success" :
            order.Status == "Cancelled" ? "bg-secondary" :
            order.Status == "Out for Delivery" ? "bg-info text-dark" : "bg-primary";

            <div class="card order-card shadow-sm border-0 mb-4 overflow-hidden"
                 data-status="@order.Status"
                 data-customer="@(order.User?.FirstName) @(order.User?.LastName)"
                 data-id="#@order.OrderId">

                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <span class="text-muted small">ORDER ID:</span> <span class="fw-bold">#@order.OrderId</span>
                        <span class="ms-3 text-muted small">DATE:</span> <span class="small">@order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>
                    <span class="badge @badgeClass px-3">@order.Status</span>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 border-end">
                            <h6 class="text-secondary fw-bold small text-uppercase mb-3">Delivery To:</h6>
                            <p class="mb-1 fw-bold">@(order.User?.FirstName) @(order.User?.LastName)</p>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @order.DeliveryAddress</p>
                            <p class="small fw-bold text-primary"><i class="bi bi-telephone"></i> @(order.User?.Phone ?? "No Phone")</p>
                        </div>

                        <div class="col-md-5 border-end">
                            <h6 class="text-secondary fw-bold small text-uppercase mb-3">Items Ordered:</h6>
                            @foreach (var item in order.OrderItems)
                            {
                                <div class="d-flex align-items-center mb-3">
                                    <img src="@(item.Variant != null && !string.IsNullOrEmpty(item.Variant.ImageUrl) ? item.Variant.ImageUrl : item.Product?.ImageUrl)"
                                         width="45" height="45" class="me-3 rounded border shadow-sm">

                                    <div style="font-size: 0.9rem;">
                                        <div class="fw-bold text-dark">@item.Product?.Name</div>
                                        @if (item.Variant != null)
                                        {
                                            <div class="text-primary small fw-bold">
                                                Variation: <span class="text-secondary">@item.Variant.VariationName</span>
                                            </div>
                                        }
                                        <div class="text-muted small">₱@item.Price.ToString("N2") x @item.Quantity</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="col-md-3 text-end">
                            <h6 class="text-secondary fw-bold small text-uppercase mb-3">Total Payment:</h6>
                            <h3 class="fw-bold text-danger">₱@order.TotalAmount.ToString("N2")</h3>
                            <p class="badge bg-light text-dark border small mt-1">Cash on Delivery</p>

                            <div class="d-grid gap-2 mt-2">
                                @switch (order.Status)
                                {
                                    case "Pending":
                                        <button class="btn btn-primary btn-sm" onclick="updateStatus(@order.OrderId, 'Confirmed')">
                                            <i class="bi bi-check-circle"></i> Accept Order
                                        </button>
                                        break;

                                    case "Confirmed":
                                        <!-- Modal Trigger Button -->
                                        <button class="btn btn-warning btn-sm text-dark" onclick="openAssignModal(@order.OrderId)">
                                            <i class="bi bi-person-badge"></i> Assign Rider
                                        </button>
                                        break;

                                    case "Out for Delivery":
                                        <span class="badge bg-info text-dark p-2">
                                            <i class="bi bi-bicycle"></i> Out for Delivery (Rider Active)
                                        </span>
                                        break;

                                    case "Completed":
                                        <span class="badge bg-success p-2"><i class="bi bi-hand-thumbs-up"></i> Order Success</span>
                                        break;

                                    case "Cancelled":
                                        <span class="badge bg-secondary p-2"><i class="bi bi-x-circle"></i> Order Cancelled</span>
                                        break;
                                }

                                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                                    <i class="bi bi-printer"></i> Print Invoice
                                </button>

                                @if (order.Status == "Pending")
                                {
                                    <button class="btn btn-link btn-sm text-decoration-none text-muted mt-1" onclick="updateStatus(@order.OrderId, 'Cancelled')">
                                        Cancel Order
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ========================================== -->
<!-- REUSABLE ASSIGN RIDER MODAL                -->
<!-- ========================================== -->
<!-- REUSABLE ASSIGN RIDER MODAL -->
<div class="modal fade" id="assignRiderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Assign Rider</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalOrderId" />

                <div class="mb-3">
                    
                    <label class="form-label fw-bold">Pili og Rider para ani nga order:</label>
                    <select id="riderSelect" class="form-select" required>

                        <option value="">Nag-load sa lista sa riders...</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top-0">
                <button onclick="updateStatus(1294, 'Assigned')">Assigned </button>
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitRiderAssignment()">Confirm Assignment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Open Modal Function
    async function openAssignModal(orderId) {
    document.getElementById('modalOrderId').value = orderId;
    document.getElementById('modalTitle').innerText = "Assign Rider para sa Order #" + orderId;

    const selectElement = document.getElementById('riderSelect');
    selectElement.innerHTML = '<option value="">Nag-load sa lista sa riders...</option>';

    // Ablihan ang Modal
    const assignModal = new bootstrap.Modal(document.getElementById('assignRiderModal'));
    assignModal.show();

    // Fetch sa mga riders gikan sa Controller
    try {
        const response = await fetch('/Admin/GetRiders');
        const riders = await response.json();

        selectElement.innerHTML = '<option value="">-- Pilia ang Rider nga i-assign --</option>';
        riders.forEach(rider => {
            const option = document.createElement('option');
            option.value = rider.userId;
            option.textContent = rider.fullName;
            selectElement.appendChild(option);
        });
    } catch (error) {
        selectElement.innerHTML = '<option value="">Failed to load riders</option>';
    }
}

// Function para sa pag-save sa Rider Assignment
function submitRiderAssignment() {

    const orderId = document.getElementById('modalOrderId').value;
    const riderId = document.getElementById('riderSelect').value;


    updateStatus(orderId, 'Assigned');

    if (!riderId) {
        Swal.fire('Pahimangno', 'Palihog pili og rider una.', 'warning');
        return;
    }

    
    

    fetch('/Admin/AssignRider', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `orderId=${orderId}&riderId=${riderId}`
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
           
                        

            location.reload();
        } else {
            Swal.fire('Error', data.message || 'Naay sayop sa pag-assign sa rider.', 'error');
        }
    });
}

        // Search ug Filter (Pure JS)
        function filterOrders(status) {
            const filterBtns = document.querySelectorAll('.filter-btn');
            filterBtns.forEach(btn => btn.classList.remove('active'));

            if (window.event && window.event.currentTarget) {
                window.event.currentTarget.classList.add('active');
            }

            const cards = document.querySelectorAll('.order-card');
            cards.forEach(card => {
                const cardStatus = card.getAttribute('data-status');
                if (status === 'All' || cardStatus === status) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('orderSearch');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const value = this.value.toLowerCase();
                    const cards = document.querySelectorAll('.order-card');

                    cards.forEach(card => {
                        const name = (card.getAttribute('data-customer') || '').toLowerCase();
                        const id = (card.getAttribute('data-id') || '').toLowerCase();

                        if (name.includes(value) || id.includes(value)) {
                            card.style.display = '';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            }
        });

        // AJAX Update Status Function
        function updateStatus(id, newStatus) {
            Swal.fire({
                title: 'Sigurado ka, boss?',
                text: "I-update nato ang order mahimong: " + newStatus,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Oo, Dayon!'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('/Admin/UpdateStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: `orderId=${id}&status=${encodeURIComponent(newStatus)}`
                    })
                    .then(response => response.json())
                    .then(res => {
                        if (res.success) {
                            location.reload();
                        } else {
                            Swal.fire('Error', 'Naay sayop sa pag-save, boss.', 'error');
                        }
                    });
                }
            });
        }

        async function saveAssignRider() {
            const orderId = document.getElementById('modalOrderId').value;
            const riderId = document.getElementById('riderSelect').value;

            if (!riderId) {
                alert("Palihug pilia ang rider.");
                return;
            }

            try {
                const response = await fetch('/Admin/AssignRider', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ orderId: parseInt(orderId), riderId: riderId })
                });

                if (response.ok) {
                    // I-close ang modal
                    const modalElement = document.getElementById('assignRiderModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalElement);
                    modalInstance.hide();

                    Swal.fire('Success', 'Nalampuson nga na-assign ang rider!', 'success');
                } else {
                    Swal.fire('Error', 'Nabaysog ang pag-assign sa rider.', 'error');
                }
            } catch (error) {
                console.error("Assign error:", error);
            }
        }

    </script>
}