@model List<MyEccomerce.Models.Order>
@{
    Layout = "_LayoutRider";
}

<div class="container mt-4 mb-5">
    <h4 class="fw-bold mb-4"><i class="bi bi-bicycle text-primary"></i> Rider Delivery Dashboard</h4>

    <div id="ordersContainer">
        @if (!Model.Any())
        {
            <div class="text-center p-5 border rounded bg-light">
                <h5 class="text-muted">Walay delivery orders nga gi-assign kanimo karon.</h5>
            </div>
        }

        @foreach (var order in Model)
        {
            var badgeClass = order.Status == "Assigned" ? "bg-warning text-dark" :
                            order.Status == "Out for Delivery" ? "bg-info text-dark" :
                            order.Status == "Completed" ? "bg-success" : "bg-secondary";

            <div class="card order-card shadow-sm border-0 mb-4 overflow-hidden">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <span class="text-muted small">ORDER ID:</span> <span class="fw-bold">#@order.OrderId</span>
                        <span class="ms-3 text-muted small">DATE:</span> <span class="small">@order.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>
                    <span class="badge @badgeClass px-3">@order.Status</span>
                </div>

                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6 border-end">
                            <h6 class="text-secondary fw-bold small text-uppercase mb-3">Delivery To:</h6>
                            <p class="mb-1 fw-bold">@(order.User?.FirstName) @(order.User?.LastName)</p>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @order.DeliveryAddress</p>
                            <p class="small fw-bold text-primary"><i class="bi bi-telephone"></i> @(order.User?.Phone ?? "No Phone")</p>
                        </div>

                        <div class="col-md-6 text-md-end mt-3 mt-md-0">
                            <h6 class="text-secondary fw-bold small text-uppercase mb-1">Total Amount to Collect:</h6>
                            <h3 class="fw-bold text-danger">₱@order.TotalAmount.ToString("N2")</h3>
                            <p class="badge bg-light text-dark border small mb-3">Cash on Delivery</p>

                            <div class="d-grid gap-2">
                                @switch (order.Status)
                                {
                                    case "Assigned":
                                        <button class="btn btn-warning btn-sm text-dark fw-bold" onclick="updateStatus(@order.OrderId, 'Out for Delivery')">
                                            <i class="bi bi-bicycle me-1"></i> Start Delivery (Out for Delivery)
                                        </button>
                                        break;

                                    case "Out for Delivery":
                                        <button class="btn btn-success btn-sm fw-bold" onclick="updateStatus(@order.OrderId, 'Completed')">
                                            <i class="bi bi-check2-circle me-1"></i> Mark as Delivered & Collected
                                        </button>
                                        break;

                                    case "Completed":
                                        <span class="badge bg-success p-2"><i class="bi bi-hand-thumbs-up"></i> Delivered Successfully</span>
                                        break;

                                    case "Cancelled":
                                        <span class="badge bg-secondary p-2"><i class="bi bi-x-circle"></i> Order Cancelled</span>
                                        break;
                                }

                                <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                                    <i class="bi bi-printer"></i> Print Receipt
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Libraries -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    // -----------------------------------------------------------------
    // 1. SignalR Setup (Mo-listen sa mga Bag-ong Orders ug Status Updates)
    // -----------------------------------------------------------------
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/updateHub")
        .withAutomaticReconnect()
        .build();

    connection.on("NewUpdateAlert", (data) => {
        // Patugtugon ang notification sound
        new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg').play().catch(e => console.log(e));

        // Toast Alert
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'info',
                title: `Order #${data.orderId} updated: ${data.status}`,
                showConfirmButton: false,
                timer: 3000
            });
        }

        // Auto-reload human sa 1.5s aron mo-reflect ang bag-ong order/status
        setTimeout(() => {
            location.reload();
        }, 1500);
    });

    connection.start()
        .then(() => console.log("SignalR Connected sa Rider Dashboard"))
        .catch(err => console.error("SignalR Connection Error: ", err.toString()));

    // -----------------------------------------------------------------
    // 2. Status Update Functions
    // -----------------------------------------------------------------
    function updateStatus(id, newStatus) {
        if (typeof Swal === 'undefined') {
            if (confirm("I-update nato ang order mahimong: " + newStatus + "?")) {
                sendStatusUpdate(id, newStatus);
            }
            return;
        }

        Swal.fire({
            title: 'Sigurado ka, boss?',
            text: "I-update nato ang order mahimong: " + newStatus,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Oo, Dayon!'
        }).then((result) => {
            if (result.isConfirmed) {
                sendStatusUpdate(id, newStatus);
            }
        });
    }

    function sendStatusUpdate(id, newStatus) {
        fetch('/Admin/UpdateStatus', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `orderId=${id}&status=${encodeURIComponent(newStatus)}`
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(res => {
                if (res.success) {
                    location.reload();
                } else {
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Error', res.message || 'Naay sayop sa pag-save, boss.', 'error');
                    } else {
                        alert('Naay sayop sa pag-save.');
                    }
                }
            })
            .catch(err => {
                console.error(err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', 'Server connection error o kulang ang Controller Action.', 'error');
                } else {
                    alert('Server connection error.');
                }
            });
    }
</script>