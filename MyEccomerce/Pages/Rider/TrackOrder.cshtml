@model MyEccomerce.Models.Order

@{
    ViewData["Title"] = "Track Order #" + Model.OrderIdGenerated;
    Layout = "_Layout";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4">
    <div class="card shadow-sm border-0" style="border-radius: 20px; overflow: hidden;">
        <div class="card-header bg-primary text-white p-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-geo-alt-fill"></i> Order ID: #@Model.OrderIdGenerated</h5>
            <small>Status: <span id="statusText">@Model.Status</span></small>
        </div>

        <!-- Fixed height map div -->
        <div id="map" style="height: 450px; width: 100%;"></div>

        <div class="card-footer bg-white p-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h6 class="text-muted small text-uppercase fw-bold">Delivery Address</h6>
                    <p class="mb-0">@Model.DeliveryAddress</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <div id="connectionStatus" class="badge bg-secondary-subtle text-secondary border">
                        Connecting to rider...
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS & SignalR JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/signalr.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Default sa Bantayan Island (11.1537, 123.8054) kon null ang DB
            var savedLat = parseFloat("@(Model.Latitude.HasValue ? Model.Latitude.Value : 37.233166)");
            var savedLng = parseFloat("@(Model.Longitude.HasValue ? Model.Longitude.Value : -3.572008)");

            console.log(@Model.Latitude);
            console.log(@Model.Longitude)

            // Setup Leaflet Map
            var map = L.map('map').setView([savedLat, savedLng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            setTimeout(function() {
                map.invalidateSize();
            }, 300);

            // Custom Icon
            var riderIcon = L.icon({
                iconUrl: 'https://cdn-icons-png.flaticon.com/512/713/713422.png',
                iconSize: [40, 40],
                iconAnchor: [20, 20],
                popupAnchor: [0, -20]
            });

            // Add Marker
            var riderMarker = L.marker([savedLat, savedLng], { icon: riderIcon }).addTo(map)
                .bindPopup("<b>B-HUB Rider</b><br>Padulong na ko, Boss!").openPopup();

            if (@(Model.Latitude.HasValue ? "true" : "false")) {
                document.getElementById("connectionStatus").className = "badge bg-info-subtle text-info border";
                document.getElementById("connectionStatus").innerHTML = "Last known location loaded";
            }

            // SignalR Setup
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/trackingHub")
                .withAutomaticReconnect()
                .build();

            const orderId = "@Model.OrderIdGenerated";

            // FIX 1: Gi-change gikan sa ReceiveLocation -> ReceiveRiderLocation
            connection.on("ReceiveLocation", function(lat, lng) {
                console.log("New GPS location received:", lat, lng);

                var newPos = new L.LatLng(lat, lng);
                riderMarker.setLatLng(newPos);
                map.panTo(newPos);

                document.getElementById("connectionStatus").className = "badge bg-success-subtle text-success border";
                document.getElementById("connectionStatus").innerHTML = "<i class='bi bi-record-fill animate-pulse'></i> Live Tracking Active";
            });

            connection.start().then(function() {
                console.log("Connected to TrackingHub");
                connection.invoke("JoinOrderGroup", orderId);
            }).catch(function(err) {
                console.error("SignalR Error: ", err.toString());
                document.getElementById("connectionStatus").innerHTML = "Connection failed";
            });
        });
    </script>

    <style>
        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: .5;
            }
        }

        #map {
            z-index: 1;
        }
    </style>
}